<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/file_progress_item_ll_progress_info"
    android:paddingLeft="10dp"
    android:paddingTop="5dp"
    android:paddingRight="10dp"
    android:paddingBottom="5dp"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="@color/main_primary_text"
        android:id="@+id/file_progress_item_tv_progress_type"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"/>
    <TextView
        android:textColor="@color/main_primary_text"
        android:textSize="13sp"
        android:gravity="center_vertical"
        android:id="@+id/file_progress_item_tv_file_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="2"
        android:minLines="2"/>
    <RelativeLayout
        android:id="@+id/file_progress_item_rl_progress_current_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textColor="@color/main_primary_text"
            android:textSize="13sp"
            android:id="@+id/file_progress_item_tv_progress_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:textIsSelectable="true"/>
        <TextView
            android:textColor="@color/vox_rim_hl"
            android:textStyle="bold"
            android:textSize="14sp"
            android:id="@+id/file_progress_item_tv_progress_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="4dp"
            android:layout_toLeftOf="@+id/file_progress_item_tv_progress_count"/>
        <TextView
            android:textColor="@color/main_primary_text"
            android:textSize="13sp"
            android:layout_toLeftOf="@id/file_progress_item_tv_progress_percent"
            android:id="@+id/file_progress_item_tv_progress_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </RelativeLayout>
    <ProgressBar
        android:id="@+id/file_progress_item_pb_total_progress"
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:minHeight="18dp"
        android:maxHeight="18dp"
        android:layout_marginTop="8dp"
        android:progressDrawable="@drawable/vox_progress_bar"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"/>
</LinearLayout>
