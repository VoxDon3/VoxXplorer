<?xml version="1.0" encoding="utf-8"?>
<com.voxdon.xplorer.widget.CheckedActivatedLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="?attr/listPreferredItemHeightSmall">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginRight="12dp"
        android:layout_marginEnd="12dp"/>
    <TextView
        android:textAppearance="?attr/textAppearanceListItemSmall"
        android:ellipsize="marquee"
        android:gravity="center_vertical"
        android:id="@android:id/text1"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"/>
    <ImageView
        android:id="@+id/need_compatibility_mode"
        android:background="@drawable/bg_transparent"
        android:paddingLeft="7dp"
        android:paddingRight="7dp"
        android:clickable="true"
        android:layout_width="32dp"
        android:layout_height="match_parent"
        android:tint="#ff888888"
        android:contentDescription="@string/compatibility_mode"
        app:srcCompat="@drawable/ic_compatibility_mode"/>
    <CheckBox
        android:id="@+id/use_http_scheme"
        android:background="@drawable/bg_transparent"
        android:paddingLeft="7dp"
        android:paddingRight="7dp"
        android:focusable="false"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="32dp"
        android:layout_height="match_parent"
        android:contentDescription="@string/http"/>
    <ImageView
        android:id="@+id/choice_indicator"
        android:duplicateParentState="true"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:src="?android:attr/listChoiceIndicatorSingle"/>
</com.voxdon.xplorer.widget.CheckedActivatedLinearLayout>
