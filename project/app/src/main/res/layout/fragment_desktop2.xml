<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/carousel_container"
        android:background="@color/desktop2_carousel_background_color"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="248dp"
        android:layout_weight="1">
        <ImageView
            android:id="@+id/carousel_bg_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="-104dp"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/ic_launcher"/>
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scaleType="fitXY"
            android:layout_alignParentBottom="true"
            app:srcCompat="@drawable/bg_wave"/>
        <RelativeLayout
            android:id="@+id/carousel_content"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="?attr/actionBarSize">
            <com.voxdon.xplorer.widget.NoChildScrollViewPager
                android:id="@+id/carousel_viewpager"
                android:layout_width="match_parent"
                android:layout_height="140dp"/>
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/carousel_indicator"
                android:background="@color/transparent"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_alignParentBottom="true"
                app:tabBackground="@drawable/indicator_dot"
                app:tabGravity="center"
                app:tabIndicatorHeight="0dp"
                app:tabMinWidth="30dp"/>
        </RelativeLayout>
    </RelativeLayout>
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout"
        android:background="@drawable/bg_desktop2_tablayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-12dp"
        app:tabGravity="fill"
        app:tabIndicatorColor="@color/desktop2_tab_text_indicator"
        app:tabIndicatorHeight="4dp"
        app:tabMode="fixed"
        app:tabSelectedTextColor="@color/desktop2_tab_text_selected"
        app:tabTextColor="@color/desktop2_tab_text_normal"/>
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/gridview_swipe_refresh_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"/>
    <com.voxdon.xplorer.widget.NoChildScrollViewPager
        android:id="@+id/tab_view_pager"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.voxdon.xplorer.widget.DesktopGridView
            android:scrollbarStyle="outsideOverlay"
            android:gravity="center"
            android:id="@+id/grid1"
            android:padding="@dimen/desktop_grid_padding"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:horizontalSpacing="@dimen/desktop_grid_horizontal_space"
            android:verticalSpacing="5dp"
            android:stretchMode="columnWidth"
            android:columnWidth="@dimen/desktop2_grid_column_width"
            android:numColumns="auto_fit"/>
        <com.voxdon.xplorer.widget.DesktopGridView
            android:scrollbarStyle="outsideOverlay"
            android:gravity="center"
            android:id="@+id/grid2"
            android:padding="@dimen/desktop_grid_padding"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:horizontalSpacing="@dimen/desktop_grid_horizontal_space"
            android:verticalSpacing="5dp"
            android:stretchMode="columnWidth"
            android:columnWidth="@dimen/desktop2_grid_column_width"
            android:numColumns="auto_fit"/>
        <com.voxdon.xplorer.widget.DesktopGridView
            android:scrollbarStyle="outsideOverlay"
            android:gravity="center"
            android:id="@+id/grid3"
            android:padding="@dimen/desktop_grid_padding"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:horizontalSpacing="@dimen/desktop_grid_horizontal_space"
            android:verticalSpacing="5dp"
            android:stretchMode="columnWidth"
            android:columnWidth="@dimen/desktop2_grid_column_width"
            android:numColumns="auto_fit"/>
    </com.voxdon.xplorer.widget.NoChildScrollViewPager>
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/snackbar_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:id="@+id/fragment_navigation_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"/>
</LinearLayout>
