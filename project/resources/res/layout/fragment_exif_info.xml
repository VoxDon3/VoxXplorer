<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/content"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.gridlayout.widget.GridLayout
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        app:alignmentMode="alignBounds"
        app:columnCount="4"
        app:useDefaultMargins="false">
        <ImageView
            android:padding="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"
            android:layout_marginEnd="10dp"
            app:srcCompat="@drawable/ic_calendar_event"
            app:tint="@color/dark_primary_text"/>
        <TextView
            android:textColor="@color/dark_primary_text"
            android:id="@+id/exif_datetime"
            android:padding="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_columnSpan="3"/>
        <ImageView
            android:id="@+id/info_icon"
            android:padding="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginEnd="10dp"
            app:layout_rowSpan="3"
            app:srcCompat="@drawable/ic_photo"
            app:tint="@color/dark_primary_text"/>
        <TextView
            android:textColor="@color/dark_primary_text"
            android:id="@+id/file_path"
            android:padding="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_columnSpan="3"/>
        <TextView
            android:textColor="@color/dark_primary_text"
            android:id="@+id/file_name"
            android:padding="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_columnSpan="3"/>
        <TextView
            android:textColor="@color/dark_primary_text"
            android:id="@+id/image_size"
            android:padding="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"
            android:layout_marginEnd="10dp"/>
        <TextView
            android:textColor="@color/dark_primary_text"
            android:id="@+id/file_size"
            android:padding="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"
            android:layout_marginEnd="10dp"/>
        <TextView
            android:textColor="@color/dark_primary_text"
            android:id="@+id/duration"
            android:padding="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ImageView
            android:id="@+id/details_icon"
            android:padding="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginEnd="10dp"
            app:layout_rowSpan="3"
            app:srcCompat="@drawable/ic_photo_camera"
            app:tint="@color/dark_primary_text"/>
        <TextView
            android:textColor="@color/dark_primary_text"
            android:id="@+id/exif_camera"
            android:padding="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_columnSpan="3"/>
        <TextView
            android:textColor="@color/dark_primary_text"
            android:id="@+id/detail_1"
            android:padding="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textColor="@color/dark_primary_text"
            android:id="@+id/detail_2"
            android:padding="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_columnSpan="2"/>
        <TextView
            android:textColor="@color/dark_primary_text"
            android:id="@+id/detail_3"
            android:padding="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textColor="@color/dark_primary_text"
            android:id="@+id/detail_4"
            android:padding="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_columnSpan="2"/>
        <ImageView
            android:id="@+id/gps_icon"
            android:padding="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginEnd="10dp"
            app:srcCompat="@drawable/ic_location"
            app:tint="@color/dark_primary_text"/>
        <TextView
            android:textColor="@color/dark_primary_text"
            android:id="@+id/gps_text"
            android:padding="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_columnSpan="3"/>
    </androidx.gridlayout.widget.GridLayout>
</LinearLayout>
