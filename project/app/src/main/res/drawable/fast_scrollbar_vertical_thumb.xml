<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item
                android:left="14dp"
                android:right="0dp">
                <shape android:shape="rectangle">
                    <padding android:left="24dp"/>
                    <solid android:color="@color/fast_scrollbar_thumb_pressed"/>
                    <size
                        android:height="48dp"
                        android:width="8dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item
                android:left="14dp"
                android:right="0dp">
                <shape android:shape="rectangle">
                    <padding android:left="24dp"/>
                    <solid android:color="@color/fast_scrollbar_thumb_normal"/>
                    <size
                        android:height="48dp"
                        android:width="8dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
