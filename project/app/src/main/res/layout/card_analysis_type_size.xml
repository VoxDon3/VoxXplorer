<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:focusable="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="8dp"
    android:layout_marginTop="8dp"
    android:layout_marginRight="8dp"
    card_view:cardBackgroundColor="@color/cardview_background"
    card_view:cardCornerRadius="2dp"
    card_view:contentPaddingLeft="@dimen/analysis_card_padding"
    card_view:contentPaddingRight="@dimen/analysis_card_padding"
    card_view:contentPaddingTop="4dp">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/card_component_title"/>
        <androidx.gridlayout.widget.GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            card_view:alignmentMode="alignBounds"
            card_view:columnCount="6"
            card_view:useDefaultMargins="true">
            <TextView
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/main_primary_text"
                android:gravity="center"
                android:id="@+id/used_percent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="0dp"
                card_view:layout_columnSpan="6"/>
            <ProgressBar
                android:id="@+id/used_progress"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="8dp"
                card_view:layout_columnSpan="6"
                style="@style/Base.Widget.AppCompat.ProgressBar.Horizontal"/>
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                card_view:layout_gravity="center_vertical"
                card_view:srcCompat="@drawable/v_shape_image"/>
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/location_images"
                card_view:layout_columnWeight="1"
                card_view:layout_gravity="fill_horizontal"
                style="@style/Widget.Analysis.Type"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/main_secondary_text"
                android:id="@+id/size_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                card_view:layout_gravity="end"/>
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                card_view:layout_gravity="center_vertical"
                card_view:srcCompat="@drawable/v_shape_music"/>
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/location_audio"
                card_view:layout_columnWeight="1"
                card_view:layout_gravity="fill_horizontal"
                style="@style/Widget.Analysis.Type"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/main_secondary_text"
                android:id="@+id/size_music"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                card_view:layout_gravity="end"/>
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                card_view:layout_gravity="center_vertical"
                card_view:srcCompat="@drawable/v_shape_video"/>
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/location_video"
                card_view:layout_columnWeight="1"
                card_view:layout_gravity="fill_horizontal"
                style="@style/Widget.Analysis.Type"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/main_secondary_text"
                android:id="@+id/size_video"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                card_view:layout_gravity="end"/>
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                card_view:layout_gravity="center_vertical"
                card_view:srcCompat="@drawable/v_shape_document"/>
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/location_document"
                card_view:layout_columnWeight="1"
                card_view:layout_gravity="fill_horizontal"
                style="@style/Widget.Analysis.Type"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/main_secondary_text"
                android:id="@+id/size_document"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                card_view:layout_gravity="end"/>
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                card_view:layout_gravity="center_vertical"
                card_view:srcCompat="@drawable/v_shape_archive"/>
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/location_archive"
                card_view:layout_columnWeight="1"
                card_view:layout_gravity="fill_horizontal"
                style="@style/Widget.Analysis.Type"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/main_secondary_text"
                android:id="@+id/size_archive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                card_view:layout_gravity="end"/>
            <ImageView
                android:id="@+id/icon_others"
                android:layout_width="16dp"
                android:layout_height="16dp"
                card_view:layout_gravity="center_vertical"
                card_view:srcCompat="@drawable/v_shape_others"/>
            <TextView
                android:id="@+id/label_others"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/filetype_others"
                card_view:layout_columnWeight="1"
                card_view:layout_gravity="fill_horizontal"
                style="@style/Widget.Analysis.Type"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/main_secondary_text"
                android:id="@+id/size_others"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                card_view:layout_gravity="end"/>
        </androidx.gridlayout.widget.GridLayout>
        <include
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/card_component_bottom"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
