<?xml version="1.0" encoding="utf-8"?>
<com.voxdon.xplorer.widget.BlockTouchRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottom_menu_layout"
    android:background="@color/actionbar_overlay"
    android:paddingTop="5dp"
    android:paddingBottom="5dp"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/bottom_menu_container"
        android:descendantFocusability="afterDescendants"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"/>
    <View
        android:id="@+id/more_anchor"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"/>
</com.voxdon.xplorer.widget.BlockTouchRelativeLayout>
