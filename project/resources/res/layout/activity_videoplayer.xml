<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:bar_gravity="center"
        app:bar_height="2dp"
        app:buffered_color="@color/videoplayer_buffered"
        app:controller_layout_id="@layout/video_player_control_view"
        app:played_color="?attr/colorPrimary"
        app:player_layout_id="@layout/video_player_view"
        app:repeat_toggle_modes="one"
        app:scrubber_color="?attr/colorPrimary"
        app:scrubber_dragged_size="18dp"
        app:scrubber_enabled_size="14dp"
        app:show_buffering="when_playing"
        app:show_shuffle_button="false"
        app:unplayed_color="@color/videoplayer_unplayed"/>
    <TextView
        android:textSize="10sp"
        android:id="@+id/debug_text_view"
        android:background="#55000088"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="100dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ads_overlay"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/ads_container"
            android:background="#ffffff"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/video_ad_marginTop"
            android:layout_marginBottom="60dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ProgressBar
            android:id="@+id/ads_progress"
            android:layout_width="60dp"
            android:layout_height="60dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Widget.AppCompat.ProgressBar"/>
        <ImageButton
            android:id="@+id/ads_close"
            android:background="?attr/selectableItemBackground"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:translationX="@dimen/video_ad_close_translate"
            android:translationY="@dimen/video_ad_close_translate"
            app:layout_constraintLeft_toLeftOf="@+id/ads_container"
            app:layout_constraintTop_toTopOf="@+id/ads_container"
            app:srcCompat="@drawable/ic_ads_close"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <RelativeLayout
        android:id="@+id/end_overlay"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/progress"
        android:visibility="gone"
        android:layout_width="60dp"
        android:layout_height="60dp"
        style="@style/Widget.AppCompat.ProgressBar"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/icon_splash"
            android:visibility="gone"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:shadowColor="#000000"
            android:shadowDx="1.5"
            android:shadowDy="1.3"
            android:shadowRadius="1.6"
            android:layout_centerInParent="true"/>
        <TextView
            android:textSize="48sp"
            android:textColor="#ffffff"
            android:id="@+id/drag_seek_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:shadowColor="#000000"
            android:shadowDx="1.5"
            android:shadowDy="1.3"
            android:shadowRadius="1.6"
            android:layout_centerInParent="true"/>
        <TextView
            android:textStyle="bold"
            android:textColor="#ffffffff"
            android:id="@+id/change_speed_playing_indicator"
            android:background="@drawable/bg_player_control_popup"
            android:paddingLeft="10dp"
            android:paddingTop="4dp"
            android:paddingRight="10dp"
            android:paddingBottom="4dp"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2X▶▶"
            android:layout_centerHorizontal="true"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/drag_control_container"
            android:background="@drawable/bg_player_control_popup"
            android:paddingLeft="10dp"
            android:paddingTop="30dp"
            android:paddingRight="10dp"
            android:paddingBottom="14dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">
            <ProgressBar
                android:layout_gravity="center"
                android:id="@+id/vertical_progressbar"
                android:layout_width="4dp"
                android:layout_height="100dp"
                style="@style/FileManager.Widget.ProgressBar.Vertical"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/vertical_progressbar_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:srcCompat="@drawable/ic_player_volume_up"/>
        </LinearLayout>
    </RelativeLayout>
    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
