<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp"
    style="@style/Widget.AlertDialog">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textColor="@color/vox_title"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:id="@+id/file_progress_tv_title"
            android:textStyle="bold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <TextView
            android:textColor="@color/vox_title"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:id="@+id/file_progress_tv_progress_percent"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <TextView
        android:textColor="@color/main_primary_text"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:gravity="center"
        android:id="@+id/file_progress_tv_prepare"
        android:layout_width="match_parent"
        android:layout_height="48dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/file_progress_ll_file_path"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textColor="@color/vox_path"
            android:textSize="12sp"
            android:id="@+id/file_progress_tv_from_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TextView
            android:textColor="@color/main_primary_text"
            android:ellipsize="middle"
            android:id="@+id/file_progress_tv_from"
            android:textSize="12sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lines="1"/>
        <TextView
            android:textColor="@color/vox_path"
            android:textSize="12sp"
            android:id="@+id/file_progress_tv_to_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"/>
        <TextView
            android:textColor="@color/main_primary_text"
            android:ellipsize="middle"
            android:id="@+id/file_progress_tv_to"
            android:textSize="12sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lines="1"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/file_progress_size_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">
        <TextView
            android:textColor="@color/main_primary_text"
            android:id="@+id/file_progress_tv_progress_size"
            android:textSize="12sp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <TextView
            android:textColor="@color/vox_path"
            android:id="@+id/file_progress_tv_transfer_rate"
            android:textSize="12sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <ProgressBar
        android:id="@+id/file_progress_pb_total_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:progressDrawable="@drawable/vox_progress_bar"
        style="@style/Base.Widget.AppCompat.ProgressBar.Horizontal"/>
    <TextView
        android:textColor="@color/main_primary_text"
        android:id="@+id/file_progress_tv_progress_count"
        android:textSize="12sp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp">
        <TextView
            android:textColor="@color/main_primary_text"
            android:id="@+id/file_progress_tv_remaining_time"
            android:textSize="12sp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <TextView
            android:textColor="@color/main_primary_text"
            android:id="@+id/file_progress_tv_elapsed_time"
            android:textSize="12sp"
            android:gravity="end"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
    </LinearLayout>
    <Button
        android:layout_gravity="center"
        android:textColor="@color/vox_title"
        android:id="@+id/cancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minWidth="72dp"
        android:text="@android:string/cancel"
        style="@style/Widget.MaterialComponents.Button.TextButton"/>
</LinearLayout>