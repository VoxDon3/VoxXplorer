<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/search_query_text"
            android:gravity="center"
            android:id="@+id/query"
            android:background="@drawable/bg_search_query"
            android:padding="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/list"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.voxdon.xplorer.widget.FileListView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:divider="@drawable/file_list_divider"
            app:layout_constraintBottom_toTopOf="@+id/snackbar_container"
            app:layout_constraintTop_toBottomOf="@+id/query"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/empty"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/snackbar_container"
            app:layout_constraintTop_toBottomOf="@+id/query">
            <TextView
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:textColor="@color/main_primary_text"
                android:gravity="center"
                android:id="@+id/noresult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/no_results"/>
            <Button
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/btn_try_another_keyword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/msg_try_another_keyword"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
        </LinearLayout>
        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/snackbar_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/bottom_menu_layout"
            app:layout_constraintTop_toBottomOf="@+id/list"/>
        <com.voxdon.xplorer.widget.BlockTouchView
            android:id="@+id/bottom_menu_safe_area"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/bottom_menu_safe_area_height"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toTopOf="@+id/bottom_menu_layout"/>
        <include
            android:id="@+id/bottom_menu_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/fragment_navigation_area"
            app:layout_constraintTop_toBottomOf="@+id/snackbar_container"
            layout="@layout/list_bottom_menu"/>
        <FrameLayout
            android:id="@+id/fragment_navigation_area"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/bottom_menu_layout"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.voxdon.xplorer.widget.RefreshProgressBar
        android:id="@+id/progressbar"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        app:barHeight="2.5dp"/>
</RelativeLayout>
