<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/vox_rim_hl" />
            <gradient
                android:angle="270"
                android:startColor="@color/vox_glass_top_hl"
                android:endColor="@color/vox_shell" />
        </shape>
    </item>
    <item
        android:left="1dp" android:top="1dp" android:right="1dp"
        android:bottom="17dp">
        <shape android:shape="rectangle">
            <corners android:radius="15dp" />
            <gradient
                android:angle="270"
                android:startColor="#4DFFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
