<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#2000E5FF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient android:startColor="#CC0C1420" android:endColor="#CC080C14" android:angle="270" />
            <stroke android:width="1.5dp" android:color="#9900E5FF" />
            <corners android:radius="15dp" />
        </shape>
    </item>
</layer-list>
