<?xml version="1.0" encoding="utf-8"?>
<com.voxdon.xplorer.widget.BlockTouchFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/main_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="no">
    <RelativeLayout
        android:id="@+id/layout_step1"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/step1centerview"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_centerInParent="true"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/main_secondary_text"
            android:id="@+id/privacy_policy"
            android:background="@drawable/bg_transparent_bound"
            android:paddingLeft="10dp"
            android:paddingTop="16dp"
            android:paddingRight="10dp"
            android:paddingBottom="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/privacy_policy"
            android:layout_below="@+id/step1centerview"
            android:layout_centerHorizontal="true"/>
        <Button
            android:textSize="18sp"
            android:id="@+id/step1_next"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="10dp"
            android:text="@string/button_next"
            android:layout_alignParentBottom="true"
            style="@style/Widget.MaterialComponents.Button"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/layout_step2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/step2centerview"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_centerInParent="true"/>
        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="10dp"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            app:srcCompat="@mipmap/ic_launcher_foreground"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="@color/main_secondary_text"
            android:id="@+id/step2description"
            android:padding="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/request_storage_permissions"
            android:layout_above="@+id/step2centerview"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="30sp"
            android:textColor="@color/main_primary_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_access_request"
            android:layout_above="@+id/step2description"
            android:layout_centerHorizontal="true"/>
        <Button
            android:textSize="18sp"
            android:id="@+id/step2_next"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="10dp"
            android:text="@string/button_next"
            android:layout_alignParentBottom="true"
            style="@style/Widget.MaterialComponents.Button"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/layout_step3"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/step3centerview"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_centerInParent="true"/>
        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="10dp"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            app:srcCompat="@mipmap/ic_launcher_foreground"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="@color/main_secondary_text"
            android:id="@+id/step3description"
            android:padding="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/request_notification_permission"
            android:layout_above="@+id/step3centerview"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="30sp"
            android:textColor="@color/main_primary_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_access_request"
            android:layout_above="@+id/step3description"
            android:layout_centerHorizontal="true"/>
        <Button
            android:textSize="18sp"
            android:id="@+id/step3_next"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="10dp"
            android:text="@string/button_next"
            android:layout_alignParentBottom="true"
            style="@style/Widget.MaterialComponents.Button"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/layout_step4"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/step4centerview"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_centerInParent="true"/>
        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="10dp"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            app:srcCompat="@mipmap/ic_launcher_foreground"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="@color/main_secondary_text"
            android:id="@+id/step4description"
            android:padding="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:layout_above="@+id/step4centerview"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="30sp"
            android:textColor="@color/main_primary_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dialog_gdpr_consent_title"
            android:layout_above="@+id/step4description"
            android:layout_centerHorizontal="true"/>
        <Button
            android:textSize="18sp"
            android:id="@+id/step4_next"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="10dp"
            android:text="@string/button_next"
            android:layout_alignParentBottom="true"
            style="@style/Widget.MaterialComponents.Button"/>
    </RelativeLayout>
</com.voxdon.xplorer.widget.BlockTouchFrameLayout>
