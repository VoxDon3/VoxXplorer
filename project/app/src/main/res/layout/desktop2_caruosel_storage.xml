<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:maxWidth="420dp"
        android:layout_centerHorizontal="true">
        <RelativeLayout
            android:id="@+id/graph_layout"
            android:layout_width="@dimen/desktop_carousel_graph_width"
            android:layout_height="@dimen/desktop_carousel_graph_height"
            app:layout_constraintEnd_toStartOf="@+id/table_layout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.voxdon.xplorer.widget.PieProgress
                android:id="@+id/pie_progress"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:barWidth="6dp"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/desktop2_carousel_foreground_color"
                android:gravity="center"
                android:id="@+id/location_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="7dp"
                android:layout_marginRight="7dp"
                android:singleLine="true"
                android:layout_centerInParent="true"/>
            <TextView
                android:textSize="26sp"
                android:textColor="@color/desktop2_carousel_foreground_color"
                android:gravity="center"
                android:id="@+id/location_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="-2dp"
                android:layout_above="@+id/location_name"
                android:layout_centerHorizontal="true"
                android:fontFamily="sans-serif-light"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/desktop2_carousel_foreground_color"
                android:id="@+id/location_percent_mark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="-2dp"
                android:text="%"
                android:layout_toRightOf="@+id/location_percent"
                android:layout_alignBaseline="@+id/location_percent"
                android:fontFamily="sans-serif-light"
                android:layout_toEndOf="@+id/location_percent"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/desktop2_carousel_foreground_color"
                android:gravity="center"
                android:id="@+id/location_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_below="@+id/location_name"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/table_layout"
            android:layout_width="140dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/graph_layout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/graph_layout"
            app:layout_constraintTop_toTopOf="@+id/graph_layout">
            <androidx.gridlayout.widget.GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                app:alignmentMode="alignMargins"
                app:columnCount="2"
                app:useDefaultMargins="false">
                <TextView
                    android:textColor="@color/desktop2_carousel_foreground_color"
                    android:paddingLeft="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="2dp"
                    android:maxWidth="100dp"
                    android:text="@string/location_images"
                    android:singleLine="true"
                    android:paddingStart="2dp"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/desktop2_carousel_foreground_color"
                    android:id="@+id/size_image"
                    android:paddingRight="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="2dp"
                    android:paddingEnd="2dp"
                    app:layout_gravity="end"/>
                <TextView
                    android:textColor="@color/desktop2_carousel_foreground_color"
                    android:paddingLeft="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="2dp"
                    android:maxWidth="100dp"
                    android:text="@string/location_audio"
                    android:singleLine="true"
                    android:paddingStart="2dp"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/desktop2_carousel_foreground_color"
                    android:id="@+id/size_audio"
                    android:paddingRight="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="2dp"
                    android:paddingEnd="2dp"
                    app:layout_gravity="end"/>
                <TextView
                    android:textColor="@color/desktop2_carousel_foreground_color"
                    android:paddingLeft="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="2dp"
                    android:maxWidth="100dp"
                    android:text="@string/location_video"
                    android:singleLine="true"
                    android:paddingStart="2dp"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/desktop2_carousel_foreground_color"
                    android:id="@+id/size_video"
                    android:paddingRight="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="2dp"
                    android:paddingEnd="2dp"
                    app:layout_gravity="end"/>
                <Button
                    android:textColor="@color/desktop2_carousel_foreground_color"
                    android:id="@+id/button_analyze"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/analyze"
                    android:singleLine="true"
                    app:layout_columnSpan="2"
                    app:strokeColor="@color/desktop2_carousel_foreground_color"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
            </androidx.gridlayout.widget.GridLayout>
        </RelativeLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</RelativeLayout>
