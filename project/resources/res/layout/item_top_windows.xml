<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/listItemBackground">
    <com.voxdon.xplorer.widget.BlockTouchLinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/location_layout"
        android:background="@color/nav_label_background"
        android:padding="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/location_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="@color/nav_secondary_text"
            android:id="@+id/location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:textIsSelectable="false"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="@color/nav_secondary_text"
            android:id="@+id/secondary_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:textIsSelectable="false"/>
    </com.voxdon.xplorer.widget.BlockTouchLinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/listItemBackground">
        <ImageView
            android:id="@+id/icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:scaleType="centerInside"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="4dp"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="@color/nav_primary_text"
            android:id="@+id/path"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textIsSelectable="false"
            android:layout_marginStart="4dp"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/clear_button"
            android:background="@drawable/bg_transparent"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:scaleType="center"
            android:contentDescription="@string/menu_remove"
            app:srcCompat="@drawable/ic_small_clear"/>
    </LinearLayout>
</LinearLayout>
