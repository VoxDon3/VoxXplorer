<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/Widget.AlertDialog.Less">
    <TextView
        android:textColor="?attr/colorControlActivated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/edit_text_padding"
        android:text="@string/dialog_entry_server_address"
        style="@style/TextAppearance.AppCompat.Caption"/>
    <com.voxdon.xplorer.widget.BaselineTextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:counterEnabled="false"
        app:hintEnabled="false"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
        <com.google.android.material.textfield.TextInputEditText
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:id="@+id/address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/dialog_entry_server_address_hint"
            android:selectAllOnFocus="true"
            android:inputType="textMultiLine"
            android:imeOptions="actionDone"/>
    </com.voxdon.xplorer.widget.BaselineTextInputLayout>
    <TextView
        android:textColor="@color/design_error"
        android:id="@+id/error_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/edit_text_padding"
        android:layout_marginTop="4dp"
        style="@style/TextAppearance.AppCompat.Caption"/>
</LinearLayout>
