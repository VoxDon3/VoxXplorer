<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/history_item_root"
    android:background="@drawable/bg_transparent_actionbar_bound"
    android:nextFocusLeft="@+id/delete"
    android:nextFocusRight="@+id/delete"
    android:descendantFocusability="beforeDescendants"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="56dp">
        <ImageView
            android:id="@+id/icon"
            android:layout_width="56dp"
            android:layout_height="match_parent"
            android:scaleType="center"
            app:srcCompat="@drawable/ic_history"
            app:tint="@color/actionbar_foreground_color"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/actionbar_foreground_color"
            android:gravity="center_vertical"
            android:id="@android:id/text1"
            android:paddingLeft="8dp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:singleLine="true"
            android:layout_weight="1"/>
        <ImageButton
            android:id="@+id/delete"
            android:background="@drawable/bg_transparent_actionbar"
            android:nextFocusLeft="@+id/history_item_root"
            android:nextFocusRight="@+id/history_item_root"
            android:layout_width="56dp"
            android:layout_height="match_parent"
            app:srcCompat="@drawable/ic_close"
            app:tint="@color/actionbar_foreground_color"/>
    </LinearLayout>
</RelativeLayout>
