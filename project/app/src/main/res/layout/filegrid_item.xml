<?xml version="1.0" encoding="utf-8"?>
<com.voxdon.xplorer.widget.ActivatableFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="2dp"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/listItemBackground">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/item_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/icon_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.voxdon.xplorer.widget.SquareImageView
                android:id="@+id/icon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scaleType="centerCrop"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/mask"
                android:visibility="gone"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_gallery_play"
                android:scaleType="centerInside"/>
            <include layout="@layout/filegrid_item_part_folder_icon"/>
            <ImageView
                android:id="@+id/shortcut"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                app:srcCompat="@drawable/ic_v_shortcut"/>
            <ImageView
                android:layout_gravity="start|bottom"
                android:id="@+id/localcopy_icon"
                android:background="@drawable/bg_subicon"
                android:padding="1dp"
                android:visibility="gone"
                android:layout_width="18dp"
                android:layout_height="18dp"/>
            <ImageView
                android:layout_gravity="end|bottom"
                android:id="@+id/subicon"
                android:background="@drawable/bg_subicon"
                android:padding="1dp"
                android:visibility="gone"
                android:layout_width="18dp"
                android:layout_height="18dp"/>
            <ImageView
                android:layout_gravity="start|top"
                android:id="@+id/created_file_indicator"
                android:visibility="gone"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_marginLeft="1dp"
                android:layout_marginTop="1dp"
                android:scaleType="fitCenter"
                android:layout_marginStart="1dp"
                app:srcCompat="@drawable/ic_created_indicator"/>
            <View
                android:id="@+id/selected_description"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/label_selected_item"/>
        </FrameLayout>
        <com.voxdon.xplorer.widget.GridFilenameTextView
            android:textSize="@dimen/file_grid_text_size"
            android:textColor="@color/main_primary_text"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:id="@+id/filename"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:minLines="2"
            android:textAlignment="center"/>
    </LinearLayout>
</com.voxdon.xplorer.widget.ActivatableFrameLayout>
